{
  "expo": {
    "name": "Stop Accidents",
    "slug": "stopaccidents",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "stopaccidents",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ]
      }
    },
    "android": {
      "package": "com.stopaccidents.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-optional-portrait",
      [
        "react-native-share",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#10151D"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez Stop Accidents à prendre des photos pour votre signalement.",
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Autorisez Stop Accidents à partager votre position avec les proches choisis, même en arrière-plan.",
          "locationWhenInUsePermission": "Autorisez Stop Accidents à utiliser votre position dès l’ouverture afin de préremplir les signalements et d’afficher votre emplacement sur la carte."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Stop Accidents à sélectionner des images pour vos signalements et votre profil.",
          "cameraPermission": "Autorisez Stop Accidents à prendre des photos pour vos signalements et votre profil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
