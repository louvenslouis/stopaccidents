{
  "expo": {
    "name": "Stop Accidents",
    "slug": "stopaccidents",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stopaccidents",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-share",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#10151D"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez Stop Accidents à prendre des photos pour votre signalement.",
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Autorisez Stop Accidents à partager votre position avec les proches choisis, même en arrière-plan.",
          "locationWhenInUsePermission": "Autorisez Stop Accidents à utiliser votre position dès l’ouverture afin de préremplir les signalements et d’afficher votre emplacement sur la carte."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Stop Accidents à enregistrer une photo de votre carte d’identité.",
          "cameraPermission": "Autorisez Stop Accidents à photographier votre carte d’identité.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/stopaccidents",
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
